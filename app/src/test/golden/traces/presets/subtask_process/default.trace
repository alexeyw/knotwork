# Golden run trace — written by GoldenTraceTest, never by hand.
# Rewrite: ./gradlew :app:testFullDebugUnitTest --tests '*GoldenTraceTest*' -PrecordGoldenTraces
pipeline: presets/subtask_process
scenario: default
about: The processing sub-pipeline on its own.
origin: CHAT
prompt:
  | Plan my Saturday evening in the city.

driver start
visit golden subtask_process/node-1 INPUT #1
state Stage step=1 of=3 INPUT
trace.console seq=0 run=golden depth=0 NodeExecution
    message:
      | ▶ INPUT
run.spend golden steps=1 tokens=0
trace.console seq=1 run=golden depth=0 NodeExecution
    message:
      | ✓ INPUT in <ms>ms
visit golden subtask_process/node-2 LITE_RT #1
state Stage step=2 of=3 LITE_RT
trace.console seq=2 run=golden depth=0 NodeExecution
    message:
      | ▶ LITE_RT
model.load path=null vision=false audio=false
model local node=node-2 call=1 temperature=default image=none
    prompt:
      | [golden prefix] Answer in plain words.
      | You are completing ONE subtask from a larger plan. It is a reasoning, writing, transformation, calculation or composition step — everything it needs is already available to you; you are not searching for facts, using tools, or asking the user.
      |
      | Today is 15 September 2026. Write your entire output in English, whatever language the user writes in. This step's output is read by later steps, not by the user — the step that writes the final answer translates it back into the user's language.
      |
      | How to work:
      | - Do exactly what the current subtask asks — no more, no less. Ignore any surrounding workflow instructions and do not try to solve the overall task or future steps.
      | - If results of earlier subtasks appear in your input, use them as the inputs to this step rather than redoing that work.
      | - Produce the concrete result the subtask calls for (the rewritten text, the answer, the computed value, the drafted content) — not a description of how you would do it.
      | - If the subtask genuinely cannot be completed from the information available, say so briefly and state what is missing, instead of inventing facts.
      | - Output only the result of this subtask, as plain text, with no preamble, no restating of the subtask, and no commentary.
      |
      | Output the subtask result only.
      |
      |
      | --- Original Task ---
      | Plan my Saturday evening in the city.
      |
      | --- Previous Node Output ---
      | Plan my Saturday evening in the city.
      | AGENT: ⏎
    answer:
      | Process answer, visit 1.
run.spend golden steps=2 tokens=4
trace.console seq=3 run=golden depth=0 NodeExecution
    message:
      | ✓ LITE_RT in <ms>ms
trace.node seq=4 run=golden node-2 LITE_RT depth=0 tokens=4
    input:
      | --- Original Task ---
      | Plan my Saturday evening in the city.
      |
      | --- Previous Node Output ---
      | Plan my Saturday evening in the city.
    output:
      | Process answer, visit 1.
state NodeIO node-2 LITE_RT depth=0
visit golden subtask_process/node-3 OUTPUT #1
state Stage step=3 of=3 OUTPUT
trace.console seq=5 run=golden depth=0 NodeExecution
    message:
      | ▶ OUTPUT
chat.save AGENT final=true model=Golden Model
    content:
      | Process answer, visit 1.
end Completed
    finalResponse:
      | Process answer, visit 1.
run.spend golden steps=3 tokens=4
trace.flush
