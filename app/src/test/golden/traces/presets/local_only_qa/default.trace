# Golden run trace — written by GoldenTraceTest, never by hand.
# Rewrite: ./gradlew :app:testFullDebugUnitTest --tests '*GoldenTraceTest*' -PrecordGoldenTraces
pipeline: presets/local_only_qa
scenario: default
about: The shortest shipped path: one on-device answer.
origin: CHAT
prompt:
  | What is the tallest mountain on Earth?

driver start
visit golden local_only_qa/input INPUT #1
state Stage step=1 of=3 INPUT
trace.console seq=0 run=golden depth=0 NodeExecution
    message:
      | ▶ INPUT
run.spend golden steps=1 tokens=0
trace.console seq=1 run=golden depth=0 NodeExecution
    message:
      | ✓ INPUT in <ms>ms
visit golden local_only_qa/lite_rt LITE_RT #1
state Stage step=2 of=3 LITE_RT
trace.console seq=2 run=golden depth=0 NodeExecution
    message:
      | ▶ LITE_RT
model.load path=null vision=false audio=false
model local node=lite_rt call=1 temperature=default image=none
    prompt:
      | [golden prefix] Answer in plain words.
      | You are a concise on-device assistant running on Golden Model. Today is 15 September 2026. Answer the user's question directly in one or two short paragraphs. Do not invent facts; if you do not know, say so plainly.
      |
      | Reply in the user's language (en-US).
      |
      |
      | --- Original Task ---
      | What is the tallest mountain on Earth?
      |
      | --- Previous Node Output ---
      | What is the tallest mountain on Earth?
      | AGENT: ⏎
    answer:
      | Local LLM answer, visit 1.
run.spend golden steps=2 tokens=5
trace.console seq=3 run=golden depth=0 NodeExecution
    message:
      | ✓ LITE_RT in <ms>ms
trace.node seq=4 run=golden lite_rt LITE_RT depth=0 tokens=5
    input:
      | --- Original Task ---
      | What is the tallest mountain on Earth?
      |
      | --- Previous Node Output ---
      | What is the tallest mountain on Earth?
    output:
      | Local LLM answer, visit 1.
state NodeIO lite_rt LITE_RT depth=0
visit golden local_only_qa/output OUTPUT #1
state Stage step=3 of=3 OUTPUT
trace.console seq=5 run=golden depth=0 NodeExecution
    message:
      | ▶ OUTPUT
chat.save AGENT final=true model=Golden Model
    content:
      | Local LLM answer, visit 1.
end Completed
    finalResponse:
      | Local LLM answer, visit 1.
run.spend golden steps=3 tokens=5
trace.flush
