pipeline: presets/local_only_qa
scenario: default
about: The shortest shipped path: one on-device answer.
origin: CHAT
outcome: COMPLETED
settings: harness defaults
prompt:
  | What is the tallest mountain on Earth?

run.create golden pipeline=local_only_qa parent=null status=QUEUED origin=CHAT hadImage=false
    userPrompt:
      | What is the tallest mountain on Earth?
run.running golden pipeline=local_only_qa graphHash=58c48685ef51e8afa00f2aed1130707f99430c40a0b86fec2ccc9533cc54ca56
driver start
crash.key active_pipeline_id=local_only_qa
crash.key active_model=Golden Model
visit golden local_only_qa/input INPUT #1
state Stage step=1 of=3 INPUT
trace.console seq=0 run=golden depth=0 NodeExecution
    message:
      | ▶ INPUT
state ConsoleLog run=golden events=1
metrics.node INPUT tokens=null
run.spend golden steps=1 tokens=0
trace.console seq=1 run=golden depth=0 NodeExecution
    message:
      | ✓ INPUT in <ms>ms
state ConsoleLog run=golden events=2
visit golden local_only_qa/lite_rt LITE_RT #1
state Stage step=2 of=3 LITE_RT
trace.console seq=2 run=golden depth=0 NodeExecution
    message:
      | ▶ LITE_RT
state ConsoleLog run=golden events=3
model.load path=null vision=false audio=false
model local node=lite_rt call=1 temperature=default image=none
    prompt:
      | [golden prefix] Answer in plain words.
      | You are a concise on-device assistant running on Golden Model. Today is 15 September 2026. Answer the user's question directly in one or two short paragraphs. Do not invent facts; if you do not know, say so plainly.
      |
      | Reply in the user's language (en-US).
      |
      |
      | --- Original Task ---
      | What is the tallest mountain on Earth?
      |
      | --- Previous Node Output ---
      | What is the tallest mountain on Earth?
      | AGENT: ⏎
    answer:
      | Local LLM answer, visit 1.
state Streaming thinking=1 answering=4
    text:
      | Local LLM answer, visit 1.
metrics.update tokens=5
modelPerformance.record path=/models/golden-model.litertlm tokens=5 benchmark=false
metrics.node LITE_RT tokens=5
run.spend golden steps=2 tokens=5
trace.console seq=3 run=golden depth=0 NodeExecution
    message:
      | ✓ LITE_RT in <ms>ms
state ConsoleLog run=golden events=4
trace.node seq=4 run=golden lite_rt LITE_RT depth=0 tokens=5
    input:
      | --- Original Task ---
      | What is the tallest mountain on Earth?
      |
      | --- Previous Node Output ---
      | What is the tallest mountain on Earth?
    output:
      | Local LLM answer, visit 1.
state PipelineTrace steps=1 last=LITE_RT depth=0 tokens=5
state NodeIO lite_rt LITE_RT depth=0 (= trace.node seq=4)
visit golden local_only_qa/output OUTPUT #1
state Stage step=3 of=3 OUTPUT
trace.console seq=5 run=golden depth=0 NodeExecution
    message:
      | ▶ OUTPUT
state ConsoleLog run=golden events=5
chat.save AGENT final=true model=Golden Model
    content:
      | Local LLM answer, visit 1.
end Completed
    finalResponse:
      | Local LLM answer, visit 1.
run.finish golden COMPLETED reason=null
    error:
      (empty)
metrics.node OUTPUT tokens=null
run.spend golden steps=3 tokens=5 (ignored: terminal or unknown run)
trace.flush
