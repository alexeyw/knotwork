# Golden run trace — written by GoldenTraceTest, never by hand.
# Rewrite: ./gradlew :app:testFullDebugUnitTest --tests '*GoldenTraceTest*' -PrecordGoldenTraces
pipeline: presets/subtask_act
scenario: picks-a-sensitive-tool-denied
about: The model picks a tool that needs approval, and the user denies it.
origin: CHAT
prompt:
  | Book a table for dinner.

driver start
visit golden subtask_act/node-1 INPUT #1
state Stage step=1 of=3 INPUT
trace.console seq=0 run=golden depth=0 NodeExecution
    message:
      | ▶ INPUT
run.spend golden steps=1 tokens=0
trace.console seq=1 run=golden depth=0 NodeExecution
    message:
      | ✓ INPUT in <ms>ms
visit golden subtask_act/node-2 TOOL #1
state Stage step=2 of=3 TOOL
trace.console seq=2 run=golden depth=0 NodeExecution
    message:
      | ▶ TOOL
model.load path=null vision=false audio=false
model local node=node-2 call=1 temperature=default image=none
    prompt:
      | You are an AI assistant that selects the best tool for a given task and generates arguments.
      |
      | AVAILABLE TOOLS:
      | Tool: search_tool
      | Description: Looks a topic up in an encyclopedia.
      | Parameters: {"type":"object","properties":{"query":{"type":"string"}},"required":["query"]}
      |
      | Tool: read_file
      | Description: Reads a file from the agent workspace.
      | Parameters: {"type":"object","properties":{"path":{"type":"string"}},"required":["path"]}
      |
      | Tool: write_file
      | Description: Writes a file in the agent workspace.
      | Parameters: {"type":"object","properties":{"path":{"type":"string"},"content":{"type":"string"}},"required":["path","content"]}
      |
      | Tool: append_file
      | Description: Appends to a file in the agent workspace.
      | Parameters: {"type":"object","properties":{"path":{"type":"string"},"content":{"type":"string"}},"required":["path","content"]}
      |
      | Tool: delete_file
      | Description: Deletes a file from the agent workspace.
      | Parameters: {"type":"object","properties":{"path":{"type":"string"}},"required":["path"]}
      |
      | TASK:
      | --- Previous Node Output ---
      | Book a table for dinner.
      |
      | INSTRUCTIONS:
      | Choose the most appropriate tool to solve the task. ⏎
      | Generate strictly valid JSON with two fields: "tool" and "arguments".
      | "tool" should be the exact name of the selected tool.
      | "arguments" should contain the parameters matching the tool's schema.
      |
      | JSON OUTPUT: ⏎
    answer:
      | {"tool": "write_file", "arguments": {"path": "plans/booking.md", "content": "Table for two at eight."}}
run.status golden WAITING_APPROVAL
trace.flush
state WaitingForApproval tool=write_file risk=SENSITIVE
    arguments:
      | {"path":"plans/booking.md","content":"Table for two at eight."}
notify.approval tool=write_file risk=SENSITIVE
driver approval deny
notify.approval.cancel
chat.save SYSTEM final=false model=null
    content:
      | User denied execution of tool: write_file
run.status golden RUNNING
state ObservationResult write_file
run.spend golden steps=2 tokens=0
trace.console seq=3 run=golden depth=0 NodeExecution
    message:
      | ✓ TOOL in <ms>ms
trace.console seq=4 run=golden depth=0 ToolCall
    message:
      | write_file
trace.node seq=5 run=golden node-2 TOOL depth=0 tokens=null tool=write_file
    input:
      | --- Previous Node Output ---
      | Book a table for dinner.
    output:
      | Execution denied by user
trace.flush
state NodeIO node-2 TOOL depth=0
visit golden subtask_act/node-3 OUTPUT #1
state Stage step=3 of=3 OUTPUT
trace.console seq=6 run=golden depth=0 NodeExecution
    message:
      | ▶ OUTPUT
chat.save AGENT final=true model=Golden Model
    content:
      | Execution denied by user
end Completed
    finalResponse:
      | Execution denied by user
run.spend golden steps=3 tokens=0
trace.flush
