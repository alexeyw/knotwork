# Golden run trace — written by GoldenTraceTest, never by hand.
# Rewrite: ./gradlew :app:testFullDebugUnitTest --tests '*GoldenTraceTest*' -PrecordGoldenTraces
pipeline: presets/showcase_full_agent
scenario: factual-complex
about: A complex factual question: a plan, a lookup per topic in a queue, a distillation and a synthesis.
origin: CHAT
outcome: COMPLETED
settings: harness defaults
prompt:
  | Compare how solar and wind power grew over the last decade.

