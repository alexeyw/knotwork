# Rewrite: ./gradlew :app:testFullDebugUnitTest --tests '*GoldenTraceTest*' -PrecordGoldenTraces
pipeline: presets/showcase_full_agent
scenario: task-nested-clarification-parked
about: A clarification inside a sub-pipeline parks the whole stack; the answer resumes it from the checkpoint.
origin: CHAT
outcome: COMPLETED
settings: harness defaults
prompt:
  | Plan my Saturday evening in the city.

