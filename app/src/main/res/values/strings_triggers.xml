    <string name="triggers_type_interval">Interval</string>
    <string name="triggers_type_interval_sub">Every N min / h</string>
    <string name="triggers_type_daily">Daily</string>
    <string name="triggers_type_daily_sub">Time of day</string>
    <string name="triggers_type_charging">Charging</string>
    <string name="triggers_type_charging_sub">Charger connects</string>
    <string name="triggers_type_network">Network</string>
    <string name="triggers_type_network_sub">On connect</string>

    <!-- Interval params -->
    <string name="triggers_interval_custom">Custom</string>
    <string name="triggers_interval_error">Interval must be at least 15 minutes</string>
    <string name="triggers_interval_floor_note">Background runs are batched; the OS may defer by a few minutes. Minimum 15 min.</string>
    <string name="triggers_unit_minutes">minutes</string>
    <string name="triggers_unit_hours">hours</string>

    <!-- Daily params -->
    <string name="triggers_daily_field_label">TIME OF DAY · 24H</string>

    <!-- Charging params -->
    <string name="triggers_charging_title">When the charger connects</string>
    <string name="triggers_charging_body">Fires once each time the device starts charging; re-arms when you unplug.</string>

    <!-- Network params -->
    <string name="triggers_wifi_only_label">Wi-Fi only</string>
    <string name="triggers_wifi_only_desc">On = only Wi-Fi connections fire it. Off = any network.</string>
    <string name="triggers_ssid_section_label">Only on these Wi-Fi networks</string>
    <string name="triggers_ssid_section_desc">Leave empty to fire on any Wi-Fi. Add names to fire only on them (needs location permission).</string>
    <string name="triggers_ssid_placeholder">e.g. Home</string>
    <string name="triggers_ssid_add">Add</string>

    <!-- Pipeline binding -->
    <string name="triggers_pipeline_label">RUN THIS PIPELINE</string>
    <string name="triggers_pipeline_none">None — leave unbound</string>
    <string name="triggers_pipeline_none_sub">The trigger stays inert</string>

    <!-- Input prompt -->
    <string name="triggers_prompt_label">INPUT PROMPT</string>
    <string name="triggers_prompt_placeholder">What should the agent do when this fires? e.g. Summarize today\'s unread mail and post the digest.</string>

    <!-- Enabled toggle -->
    <string name="triggers_enabled_label">Enabled</string>
    <string name="triggers_enabled_desc">Off = saved but won\'t fire. Also toggleable from the list.</string>

    <!-- Delete dialog -->
    <string name="triggers_delete_title">Delete this trigger?</string>
    <string name="triggers_delete_body_format">\"%1$s\" and its background schedule will be removed. The bound pipeline isn\'t affected. This can\'t be undone.</string>
    <string name="triggers_delete_confirm">Delete</string>

    <!-- List health badge -->
    <string name="triggers_health_healthy">Healthy</string>
    <string name="triggers_health_overdue">Overdue</string>
    <string name="triggers_health_last_run_failed">Last run failed</string>

    <!-- Detail screen chrome -->
    <string name="triggers_detail_subtitle">Trigger detail</string>
    <string name="triggers_detail_when">When</string>
    <string name="triggers_detail_runs">Runs</string>
    <string name="triggers_detail_state">State</string>
    <string name="triggers_detail_state_enabled">Enabled</string>
    <string name="triggers_detail_state_disabled">Disabled</string>
    <string name="triggers_detail_edit">Edit</string>
    <string name="triggers_detail_delete">Delete</string>

    <!-- Stale banner -->
    <string name="triggers_detail_stale_title_format">Not checked since %1$s</string>
    <string name="triggers_detail_stale_title_no_time">Background checks look overdue</string>
    <string name="triggers_detail_stale_body">Background checks look overdue. Some phones pause background work to save battery — this trigger may be affected.</string>

    <!-- Journal section -->
    <string name="triggers_journal_section">Evaluation journal</string>
    <string name="triggers_journal_window">last 30 days</string>
    <string name="triggers_journal_retention">Records kept for 30 days · older entries age out</string>
    <string name="triggers_journal_empty_title">No evaluations yet</string>
    <string name="triggers_journal_empty_body">This trigger hasn\'t been checked yet. Each time it\'s evaluated — whether it runs or not — you\'ll see it here.</string>

    <!-- Journal: evaluation sources -->
    <string name="triggers_journal_source_poll">Scheduled check</string>
    <string name="triggers_journal_source_event">Device event</string>
    <string name="triggers_journal_source_charging">Charging check</string>

    <!-- Journal: verdicts -->
    <string name="triggers_journal_verdict_fired">Fired</string>
    <string name="triggers_journal_verdict_rearmed">Re-armed</string>
    <string name="triggers_journal_verdict_skipped">Didn\'t run</string>
    <string name="triggers_journal_rearm_note">Condition dropped while disarmed — edge latch reset. No run.</string>

    <!-- Journal: skip-reason sentences (%1$s names the moment for condition-not-met) -->
    <string name="triggers_journal_skip_disabled">The trigger was turned off.</string>
    <string name="triggers_journal_skip_unbound">No pipeline is bound.</string>
    <string name="triggers_journal_skip_condition_not_met_format">The condition wasn\'t met at %1$s.</string>
    <string name="triggers_journal_skip_already_fired">It had already fired for this window.</string>

    <!-- Journal: run outcomes -->
    <string name="triggers_journal_outcome_pending">Running…</string>
    <string name="triggers_journal_outcome_success">Completed</string>
    <string name="triggers_journal_outcome_failure">Failed</string>
    <string name="triggers_journal_outcome_cancelled_by_system">Stopped by the system</string>
    <string name="triggers_journal_outcome_cancelled">You stopped it</string>
    <string name="triggers_journal_outcome_hitl_timeout">Timed out waiting for approval</string>
    <!-- Journal outcome: an autonomous-run ceiling ended the run. Deliberately not
         phrased as a failure — the guard the user configured did its job. -->
    <string name="triggers_journal_outcome_stopped_by_ceiling">Stopped by a safety limit</string>

    <!-- Journal: the run stopped to ask the user something. The two "parked"
         qualifiers are appended after the state when the request had to wait on
         a notification rather than being answered on the spot. -->
    <string name="triggers_journal_hitl_waiting">Waiting for your response</string>
    <string name="triggers_journal_hitl_approved">You approved it</string>
    <string name="triggers_journal_hitl_denied">You denied it</string>
    <string name="triggers_journal_hitl_answered">You answered it</string>
    <string name="triggers_journal_hitl_timed_out">No response before the window closed</string>
    <string name="triggers_journal_hitl_abandoned">The request never reached you</string>
    <string name="triggers_journal_hitl_parked_pending">in the notification shade</string>
    <string name="triggers_journal_hitl_parked_settled">from the notification</string>

    <!-- Journal: timestamps and day headers. The abbreviated "m ago" reads the
         same for every count, so it is a plain format string, not a plural. -->
    <string name="triggers_journal_time_just_now">just now</string>
    <string name="triggers_journal_time_minutes_ago">%1$dm ago</string>
    <string name="triggers_journal_day_today">Today</string>
    <string name="triggers_journal_day_yesterday">Yesterday</string>

    <!-- Top-bar link into the guide's triggers section. -->
    <string name="triggers_documentation_cd">Read about triggers</string>

    <!-- Evaluation-journal export. On the list, not on a trigger's detail: the
         document is the whole journal, every trigger at once. -->
    <string name="triggers_export_share_cd">Share the evaluation journal</string>
    <string name="triggers_export_save_cd">Save the evaluation journal</string>
</resources>
