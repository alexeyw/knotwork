<?xml version="1.0" encoding="utf-8"?>
<!--
    Triggers management surface — list, full-screen editor, delete dialog.

    A trigger binds a condition (a schedule or a device event) to a pipeline so
    the agent runs in the background and the result lands in a chat. Keys follow
    the `triggers_<surface>_<purpose>` convention.
-->
<resources>
    <!-- List screen chrome -->
    <string name="triggers_screen_title">Triggers</string>
    <string name="triggers_back_cd">Back</string>
    <string name="triggers_more_cd">More actions</string>
    <string name="triggers_fab">New trigger</string>
    <plurals name="triggers_subtitle">
        <item quantity="one">%1$d trigger · %2$d active</item>
        <item quantity="other">%1$d triggers · %2$d active</item>
    </plurals>
    <string name="triggers_unbound_hint">No pipeline yet</string>
    <!-- The verb that takes the place of the switch an unbound trigger cannot offer. -->
    <string name="triggers_bind">Bind</string>
    <string name="triggers_bind_cd">Bind a pipeline to %1$s</string>
    <!-- Detail screen: the row itself is the control, so it names the verb. -->
    <string name="triggers_unbound_action">No pipeline yet — tap to bind</string>
    <string name="triggers_menu_edit">Edit</string>
    <string name="triggers_menu_delete">Delete</string>

    <!-- Teaching empty state -->
    <string name="triggers_empty_title">Run the agent on its own</string>
    <string name="triggers_empty_body">A trigger watches for a moment — a time of day or a device event — then runs a pipeline in the background and drops the result into a chat. No need to be there.</string>
    <string name="triggers_empty_cta">Create your first trigger</string>
    <string name="triggers_empty_step_trigger">Trigger</string>
    <string name="triggers_empty_step_run">Runs</string>
    <string name="triggers_empty_step_result">Result</string>

    <!-- Error state -->
    <string name="triggers_error_title">Couldn\'t load triggers</string>
    <string name="triggers_error_body">The on-device trigger store didn\'t respond. Your triggers and their schedules are safe — this is just a read.</string>

    <!-- Human-readable condition lines -->
    <string name="triggers_condition_daily">Every day at %1$s</string>
    <string name="triggers_condition_charging">When charging connected</string>
    <string name="triggers_condition_network_any">When connected to any network</string>
    <string name="triggers_condition_network_wifi">When Wi-Fi connects</string>
    <string name="triggers_condition_network_named">When joining %1$s</string>
    <plurals name="triggers_interval_minutes">
        <item quantity="one">Every %1$d minute</item>
        <item quantity="other">Every %1$d minutes</item>
    </plurals>
    <plurals name="triggers_interval_hours">
        <item quantity="one">Every %1$d hour</item>
        <item quantity="other">Every %1$d hours</item>
    </plurals>

    <!-- Editor chrome -->
    <string name="triggers_editor_title_new">New trigger</string>
    <string name="triggers_editor_title_edit">Edit trigger</string>
    <string name="triggers_editor_subtitle_new">draft</string>
    <string name="triggers_editor_subtitle_edit">saved</string>
    <string name="triggers_editor_close_cd">Close</string>
    <string name="triggers_editor_required">required</string>
    <string name="triggers_editor_kicker">TRIGGER</string>
    <string name="triggers_editor_kicker_body">A condition runs a pipeline in the background — the result lands in chat.</string>
    <string name="triggers_editor_name_label">NAME</string>
    <string name="triggers_editor_name_placeholder">e.g. Overnight summary</string>
    <string name="triggers_editor_name_error">Name is required</string>
    <string name="triggers_editor_condition_label">WHEN</string>
    <string name="triggers_editor_delete">Delete trigger</string>

