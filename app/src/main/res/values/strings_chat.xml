    <!--
        Generic, pipeline-agnostic empty-state suggestion cards. Shown only as a
        fallback when the active pipeline declares no starter prompts of its own
        (see PipelineGraph.samplePrompts). They deliberately make NO tool claims
        (`tools` is empty, so the mono "uses · …" subtitle is hidden) because the
        active pipeline's real capabilities are unknown here — a static tool
        promise could advertise tools the pipeline does not wire.
    -->
    <string name="chat_home_suggestion_card_1_title">What can you help me with?</string>
    <string name="chat_home_suggestion_card_1_tools" />
    <string name="chat_home_suggestion_card_2_title">Summarise a long note I paste in</string>
