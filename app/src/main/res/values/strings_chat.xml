    <!-- Reporting a model-authored response. The disclosure is deliberately blunt:
         there is no reporting back end, so the user must know that submitting means
         a public issue and that they can edit the text before it goes anywhere. -->
    <string name="chat_report_dialog_title">Report this response</string>
    <string name="chat_report_dialog_body">Tell me what is wrong with what the model produced. This helps improve the pipelines and prompts that ship with the app.</string>
    <string name="chat_report_dialog_note_placeholder">What is wrong with this response? (optional)</string>
    <string name="chat_report_dialog_disclosure">Nothing is sent automatically. Open issue puts this report in a GitHub link, so GitHub receives it when the page opens; it goes public only if you submit it. To edit it first, copy it instead.</string>
