        Agent status lines rendered in the pill above the composer. Two spaces
        between the bracketed tag and the body keep the surfaces vertically
        aligned with the mockup.
    -->
    <string name="chat_home_status_idle">[NODE]  idle · ready</string>
    <string name="chat_home_status_generating">[NODE]  generating</string>
