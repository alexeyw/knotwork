<?xml version="1.0" encoding="utf-8"?>
<!--
    Shared, feature-agnostic UI strings.

    Keys follow the convention `common_<purpose>` and cover affordances that
    appear in multiple features (dialog actions, generic verbs, simple
    placeholders). Anything specific to a single feature lives in that
    feature's strings file.
-->
<resources>
    <string name="common_cancel">Cancel</string>
    <string name="common_save">Save</string>
    <string name="common_delete">Delete</string>
    <string name="common_create">Create</string>
    <string name="common_close">Close</string>
    <string name="common_back">Back</string>
    <string name="common_retry">Retry</string>
    <string name="common_ok">OK</string>
    <!-- Joins items inside one sentence or one list line ("tools and steps",
         "Web search, Fetch a URL"). Separate from a bullet list so a
         translation can carry its language's own spacing. -->
    <string name="common_list_separator">", "</string>
    <!-- The language these strings are written in, as a BCP-47 tag. Not shown:
         it names the language the interface is in, which picks the bundled
         presets' translation (assets/presets/l10n/<tag>.json). Each translation
         writes its own tag here; TranslationCoverageTest holds the two equal. -->
    <string name="interface_language_tag">en</string>

    <!-- Bottom navigation tab labels -->
    <string name="nav_tab_chat">Chat</string>
    <string name="nav_tab_pipelines">Pipelines</string>
    <string name="nav_tab_tools">Tools</string>
    <string name="nav_tab_more">More</string>

    <!-- "More" tab landing screen rows -->
    <string name="more_row_memory">Memory</string>
    <string name="more_row_models">Models</string>
    <string name="more_row_prompts">Prompt library</string>
    <string name="more_row_task_monitor">Tasks</string>
    <string name="more_row_monitoring">Live metrics</string>
    <string name="more_row_settings">Settings</string>
    <string name="more_row_about">About</string>
    <string name="more_row_library">Pipeline preset library</string>
    <string name="more_row_files">Files</string>
    <!-- More-tab entry into the chat archive. Always shown; the count lives in the
         subtitle, never in a badge — a badge says "needs attention", an archive never does. -->
    <string name="more_row_chat_archive">Archived chats</string>
    <string name="more_chat_archive_subtitle_empty">Nothing archived yet</string>
    <plurals name="more_chat_archive_subtitle">
        <item quantity="one">%1$d chat</item>
        <item quantity="other">%1$d chats</item>
    </plurals>
    <string name="more_row_triggers">Triggers</string>
    <string name="more_triggers_subtitle">Run pipelines on a schedule or device event</string>
    <string name="more_subtitle">Everything else</string>
    <!-- More tab section headings. Order is "why you opened More, most often
         first"; App is last because that is where Android users look for
         Settings. Diagnostics is deliberately not a section: only Live metrics
         would live in it, and a section of one is a heading pretending to be
         structure. -->
    <string name="more_section_automation">AUTOMATION</string>
    <string name="more_section_content">YOUR CONTENT</string>
    <string name="more_section_blocks">BUILDING BLOCKS</string>
    <string name="more_section_app">APP</string>

    <!-- About screen stub -->
    <string name="about_title">About</string>
    <string name="about_version">Version %1$s</string>

    <!-- Prompt preview bottom sheet (reused across orchestrator + prompts) -->
    <string name="prompt_preview_title">Prompt preview</string>
    <string name="prompt_preview_variable_not_found">Variable not found</string>

    <!-- Journal export (shared by the trigger journal and the external-request
         journal: one operation, so one set of words for its outcomes). -->
    <string name="journal_export_chooser_title">Share journal</string>
    <string name="journal_export_share_failed">No app on this phone can receive the file</string>
    <string name="journal_export_save_failed">Couldn\'t save the journal</string>
    <!-- Distinct from the two above: nothing was produced to save or share. -->
    <string name="journal_export_render_failed">Couldn\'t read the journal</string>
    <!-- The count is in the message on purpose: an export of an empty journal
         produces a real file, so only the number tells the reader there was
         nothing in it. -->
    <plurals name="journal_export_saved">
        <item quantity="one">Saved %1$d entry</item>
        <item quantity="other">Saved %1$d entries</item>
    </plurals>
    <!-- Size units; %1$s is the number, already written in the language. -->
    <string name="unit_size_bytes">%1$s B</string>
    <string name="unit_size_kilobytes">%1$s KB</string>
    <string name="unit_size_megabytes">%1$s MB</string>
    <string name="unit_size_gigabytes">%1$s GB</string>
    <!-- Short ages in lists; %1$d is the count. -->
    <string name="unit_age_now">now</string>
    <string name="unit_age_minutes">%1$d m</string>
    <string name="unit_age_hours">%1$d h</string>
    <string name="unit_age_days">%1$d d</string>
    <string name="unit_age_weeks">%1$d w</string>
    <!-- Names the app gives what it creates before a person names it (DefaultNames). Stored as written, in the language of the moment. -->
    <string name="default_name_chat">New Chat</string>
    <string name="default_name_imported_chat">Imported Chat</string>
    <string name="default_name_chat_with_id">Chat %1$s</string>
    <string name="default_name_trigger_chat">Trigger</string>
    <string name="default_name_pipeline">New Pipeline</string>
    <string name="default_name_input_node">Input</string>
    <string name="default_name_output_node">Output</string>
    <string name="default_name_copy">%1$s (copy)</string>
</resources>
